class GraphRAGGemini:

    STOP_WORDS: Set[str] = {
        'the', 'a', 'an', 'of', 'in', 'to', 'for', 'and', 'or', 'by',
        'with', 'is', 'it', 'as', 'at', 'on', 'are', 'was', 'were',
        'i', 'me', 'my', 'we', 'our', 'you', 'your', 'they', 'them',
        'books', 'book', 'does', 'library', 'have', 'catalog', 'catalogue',
        'seattle', 'public', 'spl',
        'want', 'need', 'find', 'looking', 'search', 'show', 'give', 'get',
        'some', 'about', 'from', 'that', 'this', 'what', 'which', 'who',
        'can', 'could', 'would', 'should', 'will', 'may', 'might',
        'any', 'all', 'more', 'most', 'other', 'new', 'good', 'great',
        'read', 'something', 'anything', 'recommend', 'similar', 'like',
        'please', 'help', 'tell', 'list'
    }

    def __init__(self, neo4j_uri, neo4j_user, neo4j_password,
                 database="neo4j", google_api_key=None):

        self.driver = GraphDatabase.driver(neo4j_uri, auth=(neo4j_user, neo4j_password))
        self.database = database

        # Gemini client
        self.model_name = "gemini-2.5-flash"
        self.client = Client(api_key=google_api_key)

        self._verify_connection()

    def _verify_connection(self):
        try:
            with self.driver.session(database=self.database) as session:
                session.run("RETURN 1 AS test").single()
        except Exception as e:
            raise Exception(f"Neo4j connection failed: {e}")

    def close(self):
        self.driver.close()

    def _parse_query_intent(self, query: str) -> Tuple[str, str]:
        q = query.lower().strip()

        # SIMILAR BOOKS
        similar_patterns = [
            r'(?:books?\s+)?(?:like|similar\s+to|such\s+as)\s+(.+)',
            r'(?:recommend\s+)?(?:something|books?)\s+like\s+(.+)'
        ]
        for p in similar_patterns:
            m = re.search(p, q)
            if m:
                return "similar", m.group(1).strip()

        # AUTHOR
        author_patterns = [
            r'(?:books?\s+)?(?:written\s+by|by)\s+(.+)',
            r'(.+?)(?:\'s)?\s+books?$'
        ]
        for p in author_patterns:
            m = re.search(p, q)
            if m:
                return "author", m.group(1).strip()

        return "keyword", query


    def _parse_query_logic(self, query: str):
        up = query.upper()
        if " AND " in up:
            parts = re.split(r'\s+AND\s+', query, flags=re.IGNORECASE)
            kw = [p.strip().lower() for p in parts if p.strip()]
            return kw, "AND"
        if " OR " in up:
            parts = re.split(r'\s+OR\s+', query, flags=re.IGNORECASE)
            kw = [p.strip().lower() for p in parts if p.strip()]
            return kw, "OR"

        # Default
        words = query.lower().split()
        kw = [w for w in words if w not in self.STOP_WORDS and len(w) > 2]
        return kw if kw else words[:3], "OR"

    def _filter_keywords(self, query: str):
        words = query.lower().split()
        kw = [w for w in words if w not in self.STOP_WORDS and len(w) > 2]
        if not kw:
            kw = words[:3]

        expanded = []
        for w in kw:
            expanded.append(w)
            if w.endswith("s"):
                expanded.append(w[:-1])
            else:
                expanded.append(w + "s")

        return list(dict.fromkeys(expanded))


    def retrieve_books_by_keyword(self, query: str, limit=10, debug=False):
        keywords, logic = self._parse_query_logic(query)

        with self.driver.session(database=self.database) as session:
            result = session.run("""
                MATCH (b:Book)
                OPTIONAL MATCH (b)-[:WRITTEN_BY]->(a:Author)
                OPTIONAL MATCH (b)-[:HAS_SUBJECT]->(g:Genre)
                RETURN b.title AS title,
                       collect(DISTINCT a.author) AS authors,
                       collect(DISTINCT g.subject_1) AS genres
            """).data()

        books = []
        for r in result:
            text = " ".join([
                r["title"] or "",
                " ".join([a for a in r["authors"] or []]),
                " ".join([g for g in r["genres"] or []]),
            ]).lower()

            matches = 0
            for kw in keywords:
                if re.search(r"\b" + re.escape(kw) + r"\b", text):
                    matches += 1

            if logic == "AND" and matches < len(keywords):
                continue
            if logic == "OR" and matches == 0:
                continue

            books.append({
                "title": r["title"],
                "authors": [a for a in r["authors"] if a],
                "genres": [g for g in r["genres"] if g],
                "relevance": matches
            })

        books.sort(key=lambda x: x["relevance"], reverse=True)
        return books[:limit]


    def retrieve_books_by_author(self, author_name: str, limit=10):
        cleaned = author_name.lower().replace(".", " ").replace(",", " ")
        words = [p.strip() for p in cleaned.split() if p.strip()]
        surname = max(words, key=len) if words else cleaned

        with self.driver.session(database=self.database) as session:
            result = session.run("""
                MATCH (b:Book)-[:WRITTEN_BY]->(a:Author)
                WHERE toLower(a.author) CONTAINS $surname
                OPTIONAL MATCH (b)-[:HAS_SUBJECT]->(g:Genre)
                RETURN b.title AS title, a.author AS author,
                       collect(g.subject_1) AS genres
            """, surname=surname)

        out = []
        for r in result:
            out.append({
                "title": r["title"],
                "authors": [r["author"]],
                "genres": [g for g in r["genres"] if g]
            })
            if len(out) >= limit:
                break
        return out


    def smart_retrieve(self, query, limit=5, debug=True):
        intent, term = self._parse_query_intent(query)

        if intent == "author":
            return self.retrieve_books_by_author(term, limit), "author"
        elif intent == "similar":
            return self.retrieve_books_by_keyword(term, limit), "similar"
        else:
            return self.retrieve_books_by_keyword(query, limit), "keyword"


    def format_context(self, books):
        if not books:
            return "No books found."
        lines = ["Available books:\n"]
        for i, b in enumerate(books, 1):
            lines.append(f"{i}. {b['title']}")
            if b.get("authors"):
                lines.append("   Authors: " + ", ".join(b["authors"]))
            if b.get("genres"):
                lines.append("   Genres: " + ", ".join(b["genres"][:3]))
        return "\n".join(lines)


    def generate_response(self, query, context, books=None, stream=False):
        if not books:
            return """Hi! I'm Chatalog, a chatbot for the Seattle Public Library.

I couldn't find any books matching your request.

You can suggest a title here:
https://www.spl.org/books-and-media/suggest-a-title"""

        book_list = ""
        for i, b in enumerate(books, 1):
            line = f"\n{i}. {b['title']}"
            if b.get("authors"):
                line += f" by {', '.join(b['authors'])}"
            book_list += line

        prompt = f"""
You are Chatalog, a friendly chatbot for the Seattle Public Library.

A patron asked: "{query}"

I found {len(books)} books:

{book_list}

Write a friendly answer. Do NOT fabricate catalog data.
"""

        try:
            resp = self.client.models.generate_content(
                 model=self.model_name,
                contents=prompt
            )

            return resp.text
        except Exception as e:
            return f"Error generating response: {e}"

  
    def recommend(self, query, retrieval_method="smart", limit=5):
        print(f"\nQuery: {query}")
        print(f"Method: {retrieval_method}\n")

        if retrieval_method == "smart":
            books, used = self.smart_retrieve(query, limit)
        else:
            books = self.retrieve_books_by_keyword(query, limit)
            used = "keyword"

        print(f"Found {len(books)} books (method: {used})\n")

        ctx = self.format_context(books)
        response = self.generate_response(query, ctx, books=books)
        return {
            "query": query,
            "retrieval_method": used,
            "retrieved_books": books,
            "num_books_retrieved": len(books),
            "response": response
        }

